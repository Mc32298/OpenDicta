{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDicta",
  "version": "0.2.4",
  "identifier": "com.OpenDicta.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "voicebar",
        "url": "/?window=voicebar",
        "title": "OpenDicta",
        "width": 280,
        "height": 62,
        "minWidth": 160,
        "minHeight": 62,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "quickswitch",
        "url": "/?window=quickswitch",
        "title": "OpenDicta Quick Switch",
        "width": 380,
        "height": 420,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' https://huggingface.co; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Mc32298/OpenDicta/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENjAxOTBBNDc4MjBGMjUKUldRbEQ0SkhDaGxnVGNINE5KUzdQcnFkZ0QyQUkxNThRMU9BNVQybnkwYllPSnh3MkZORklxRloK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
